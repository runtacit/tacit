# Tacit Container Environment Configuration

# Host directory containing your podcast audio files
WATCH_DIRECTORY=/podcasts

# Local Speech-to-Text Endpoint (Faster-Whisper ASR)
STT_ENDPOINT_URL=http://whisper:9000/asr

# LLM Service Base URL (Ollama, vLLM, or OpenAI API)
LLM_ENDPOINT_URL=http://ollama:11434/v1

# Target LLM Model Name
LLM_MODEL_NAME=qwen2.5:14b

# Background Scan Frequency (in minutes)
SCAN_INTERVAL_MINUTES=60

# Non-root User & Group ID Compatibility (Unraid / Linux)
PUID=1000
PGID=1000
UMASK=022
